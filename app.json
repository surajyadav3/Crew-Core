{
  "expo": {
    "name": "Crewcore HRMS",
    "slug": "crew-core",
    "scheme": "crew-core",
    "version": "1.1.13",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F3FF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.crewcore.app",
      "buildNumber": "6",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["location"],
        "NSLocationAlwaysAndWhenInUseUsageDescription": "CrewCore uses your location for office attendance check-in, and — only for employees your company has specifically enabled work-location tracking for — to record your location while you're clocked in, including when the app is in the background.",
        "NSLocationAlwaysUsageDescription": "CrewCore uses your location for office attendance check-in, and — only for employees your company has specifically enabled work-location tracking for — to record your location while you're clocked in, including when the app is in the background."
      }
    },
    "android": {
      "package": "com.crewcore.app",
      "versionCode": 39,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#5849C2"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ],
      "intentFilters": []
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "CrewCore uses your location for office attendance check-in, and — only for employees your company has specifically enabled work-location tracking for — to record your location while clocked in, including in the background.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "expo-task-manager",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "ndkVersion": "27.1.12297006",
            "newArchEnabled": false
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#6C5CE7"
        }
      ],
      "expo-font",
      "expo-asset",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "3f2743b3-6998-4b9d-9591-d3c26c0272e8"
      }
    },
    "owner": "surajyadav3"
  }
}
